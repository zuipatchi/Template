<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="Modal.uss" />
    <ui:VisualElement class="modal-card">
        <ui:Label text="Option" class="modal-title"/>
        <ui:VisualElement class="divider"/>
        <ui:VisualElement class="option-row">
            <ui:Label text="BGM" name="BGM" class="option-label"/>
            <ui:Slider high-value="1" value="0.5" name="BGMSlider" class="option-slider"/>
        </ui:VisualElement>
        <ui:VisualElement class="option-row option-row--last">
            <ui:Label text="SE" name="SE" class="option-label"/>
            <ui:Slider high-value="1" value="0.5" name="SESlider" class="option-slider"/>
        </ui:VisualElement>
        <ui:VisualElement class="modal-actions">
            <ui:Button text="タイトルに戻る" name="ExitButton" class="btn-secondary modal-actions__exit" />
            <ui:Button text="Close" name="CloseButton" class="btn-accent modal-actions__close" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
