.shop {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: #4e302b;
    color: #492d27;
}
.shop-title {
    color: #fff4de;
    font-size: 43px;
    margin-bottom: 12px;
}
.counter {
    width: 84%;
    max-width: 1040px;
    min-height: 490px;
    justify-content: center;
    align-items: center;
    padding: 22px 24px;
    background-color: #fff4de;
    border-radius: 26px;
}
.progress {
    color: #805448;
    font-size: 22px;
}
.order {
    font-size: 38px;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}
.choices {
    width: 100%;
    flex-direction: row;
    justify-content: center;
}
.choice {
    width: 30%;
    max-width: 300px;
    min-height: 174px;
    justify-content: center;
    align-items: center;
    padding: 8px 2px;
    margin: 4px 6px;
    border-width: 3px;
    border-color: #d5a086;
    border-radius: 14px;
    background-color: #fff4de;
    color: #492d27;
    font-size: 23px;
}
.choice:hover, .choice:focus, .choice.is-selected {
    border-color: #a34141;
}
.choice:disabled {
    opacity: 1;
    color: #492d27;
}
.picture {
    width: 100%;
    height: 130px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}
.feedback {
    font-size: 22px;
    margin-top: 8px;
    -unity-text-align: middle-center;
}
.actions {
    min-height: 55px;
    justify-content: center;
    align-items: center;
}
.action {
    background-color: #893c39;
    color: #fff4de;
    border-width: 0;
    border-radius: 10px;
    min-width: 165px;
    font-size: 23px;
    padding: 5px 16px;
}
.action:hover, .action:focus {
    background-color: #672d2b;
}
.is-hidden {
    display: none;
}
.pudding {
    background-image: url("Pudding.png");
}
.donut {
    background-image: url("Donut.png");
}
.shortcake {
    background-image: url("Shortcake.png");
}
