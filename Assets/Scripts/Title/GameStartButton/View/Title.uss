.cafe-title {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: #39241f;
    background-image: url("TitleCafe.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}
.cafe-sign {
    align-items: center;
    justify-content: center;
    margin-bottom: 75px;
    padding: 20px 38px 40px;
    border-radius: 24px;
    background-color: rgba(48, 26, 20, 0.84);
}
.cafe-name {
    color: #fff4de;
    font-size: 64px;
    -unity-text-align: middle-center;
}
.cafe-caption {
    color: #f5c7a4;
    font-size: 23px;
    -unity-text-align: middle-center;
}
.press-start {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    margin: 0;
    padding-top: 130px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: #fff4de;
    font-size: 22px;
    -unity-text-align: middle-center;
}
.press-start:hover, .press-start:focus, .press-start:active {
    background-color: rgba(0, 0, 0, 0);
    color: #ffffff;
}
