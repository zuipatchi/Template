<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Title.uss" />
    <ui:VisualElement name="SnackTitleArt" class="cafe-title">
        <ui:VisualElement class="cafe-sign" picking-mode="Ignore">
            <ui:Label text="おやつ屋さん" class="cafe-name" picking-mode="Ignore"/>
            <ui:Label text="注文を読んで、おやつを選ぼう" class="cafe-caption" picking-mode="Ignore"/>
        </ui:VisualElement>
        <ui:Button text="クリックしてスタート" name="GameStartButton" class="press-start"/>
    </ui:VisualElement>
</ui:UXML>
