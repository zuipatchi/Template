<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="Home.uss" />
    <ui:VisualElement class="home-root">

        <!-- メインカード -->
        <ui:VisualElement class="card home-card">
            <ui:Label text="HOME" class="card__title" />
            <ui:VisualElement class="divider" />
            <ui:Button name="GameStartButton" text="ゲーム開始" class="btn-accent home-start-button" />
            <ui:Button name="CreditButton" text="クレジット" class="btn-secondary" />
        </ui:VisualElement>

        <!-- クレジットオーバーレイ -->
        <ui:VisualElement name="CreditOverlay" class="overlay-bg credit-overlay">
            <ui:VisualElement class="card home-card">
                <ui:Label text="クレジット" class="card__title" />
                <ui:VisualElement class="divider" />
                <ui:VisualElement name="CreditList" class="credit-list" />
                <ui:Button name="CloseCreditButton" text="閉じる" class="btn-secondary" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
