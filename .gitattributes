# 改行コードを正規化（リポジトリ内は LF、チェックアウト時はプラットフォーム依存）
* text=auto

# ソース・テキスト
*.cs        text diff=csharp
*.shader    text
*.cginc     text
*.hlsl      text
*.uss       text
*.uxml      text
*.json      text
*.md        text
*.txt       text
*.xml       text
*.rsp       text
*.asmdef    text
*.asmref    text

# シェルスクリプト（bash で実行するため CRLF にしない）
*.sh        text eol=lf

# Unity YAML（Unity は常に LF で書き出すため、チェックアウトも LF に固定する。
# autocrlf=true の環境で CRLF になると、Unity が保存し直すたびに改行コードだけの差分が出続ける）
*.meta       text eol=lf
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.physicMaterial text eol=lf
*.playerprefs    text eol=lf

# バイナリ（正規化しない）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.psd   binary
*.tga   binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.ttf   binary
*.otf   binary
*.fbx   binary
*.dll   binary
*.bytes binary
*.unitypackage binary
